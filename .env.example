# Salin menjadi .env lalu sesuaikan. Jangan commit .env berisi secret.
SECRET_KEY=
DATABASE_PATH=instance/dashboard.db
SESSION_LIFETIME_HOURS=8
SESSION_COOKIE_SECURE=false
CSRF_ENABLED=true

# demo = data simulasi berlabel; live = ambil dari sumber eksternal.
DATA_MODE=demo
POLL_INTERVAL_MS=5000
STATS_WINDOW_SECONDS=300
HISTORY_MAX_POINTS=120
API_TIMEOUT_SECONDS=4

API_BASE_URL=http://localhost:5000

# Endpoint sumber data (kosongkan jika belum tersedia).
LIGHTGBM_API_URL=
RANDOM_FOREST_API_URL=
FAIL2BAN_API_URL=
ATTACK_HISTORY_API_URL=
# Token Bearer untuk API attack history (hanya dibaca backend).
ATTACK_HISTORY_API_TOKEN=
# Sumber deteksi tambahan (dipisah koma), digabung dengan sumber utama.
# Token diposisikan sepadan dengan URL; token kurang memakai ATTACK_HISTORY_API_TOKEN.
# ATTACK_HISTORY_EXTRA_API_URLS=http://192.168.1.7:8080/api/attacks
# ATTACK_HISTORY_EXTRA_API_TOKENS=<token dari .lightgbm-api.env di VM>
ATTACK_HISTORY_EXTRA_API_URLS=
ATTACK_HISTORY_EXTRA_API_TOKENS=
# Endpoint 14 fitur flow untuk randomforest-vm (fallback default).
FLOW_FEATURES_API_URL=
# Opsional per VM. Jika kosong, VM terkait menampilkan status belum tersedia.
FLOW_FEATURES_RANDOM_FOREST_URL=
FLOW_FEATURES_LIGHTGBM_URL=
FLOW_FEATURES_FAIL2BAN_URL=
# Opsional; jika kosong memakai ATTACK_HISTORY_API_TOKEN.
FLOW_FEATURES_API_TOKEN=
# Token khusus per VM untuk endpoint flow features.
# Jika kosong memakai FLOW_FEATURES_API_TOKEN lalu ATTACK_HISTORY_API_TOKEN.
FLOW_FEATURES_LIGHTGBM_TOKEN=
FLOW_FEATURES_RANDOM_FOREST_TOKEN=
FLOW_FEATURES_FAIL2BAN_TOKEN=
GLANCES_LIGHTGBM_URL=
GLANCES_RANDOM_FOREST_URL=
GLANCES_FAIL2BAN_URL=
# Contoh integrasi VM RF lewat SSH tunnel lokal:
# GLANCES_RANDOM_FOREST_URL=http://127.0.0.1:61210
# ATTACK_HISTORY_API_URL=http://127.0.0.1:18080/api/attacks
# FLOW_FEATURES_RANDOM_FOREST_URL=http://127.0.0.1:18080/api/features
# IP tiap VM; semua URL di bawah memakai variabel ini (harus ditulis di atas
# pemakaiannya karena python-dotenv resolving variabel sesuai urutan file).
# VM_HOST       = VM lightgbm (17 fitur, model LightGBM)
# RF_VM_HOST    = VM random forest (14 fitur, model RandomForestClassifier)
VM_HOST=
RF_VM_HOST=

# Contoh VM LightGBM (17 fitur) yang diakses langsung lewat jaringan:
# FLOW_FEATURES_LIGHTGBM_URL=http://${VM_HOST}:8080/api/features
# FLOW_FEATURES_LIGHTGBM_TOKEN=<token dari .lightgbm-api.env di VM>
# GLANCES_LIGHTGBM_URL=http://${VM_HOST}:61208
# ATTACK_HISTORY_EXTRA_API_URLS=http://${VM_HOST}:8080/api/attacks
# ATTACK_HISTORY_EXTRA_API_TOKENS=<token dari .lightgbm-api.env di VM>
#
# Contoh VM Random Forest (14 fitur) yang diakses langsung lewat jaringan:
# ATTACK_HISTORY_API_URL=http://${RF_VM_HOST}:8080/api/attacks
# FLOW_FEATURES_API_URL=http://${RF_VM_HOST}:8080/api/features
# GLANCES_RANDOM_FOREST_URL=http://${RF_VM_HOST}:61208
# Label host yang ditampilkan; ubah untuk host non-VM (mis. laptop-monitoring).
GLANCES_LIGHTGBM_LABEL=lightgbm-vm
GLANCES_RANDOM_FOREST_LABEL=randomforest-vm
GLANCES_FAIL2BAN_LABEL=fail2ban-vm

# QoS (iperf3/ICMP) untuk satu VM (mode lama, dipakai bila QOS_VMS kosong).
QOS_VM=randomforest-vm
# VM yang diukur QoS-nya, dipisah koma. Target ping/iperf3 diambil dari
# VM_HOST (lightgbm) dan RF_VM_HOST (random forest).
QOS_VMS=
# Retensi titik sampel QoS (independen dari STATS_WINDOW_SECONDS).
QOS_HISTORY_POINTS=240
# Mode otomatis: scheduler di services/qos_scheduler.py menjalankan pengukuran
# tiap QOS_AUTO_INTERVAL_SECONDS tanpa perlu menekan tombol.
# Metrik: ping (delay) dan/atau iperf3 (throughput, jitter, packet loss).
QOS_AUTO_ENABLED=false
QOS_AUTO_INTERVAL_SECONDS=5
QOS_AUTO_METRICS=ping,iperf3
# Profil iperf3 khusus mode otomatis (dibuat ringan supaya tidak membebani
# jaringan Wi-Fi dan tidak memicu galat pada jalur relay).
QOS_AUTO_IPERF3_DURATION_SECONDS=3
QOS_AUTO_IPERF3_BANDWIDTH=2M
# Jeda minimal sebelum iperf3 berikutnya dijalankan (server iperf3 hanya
# melayani satu tes pada satu waktu).
QOS_AUTO_IPERF3_COOLDOWN_SECONDS=4
# Protokol iperf3 untuk mode otomatis: tcp lebih andal lewat relay Tailscale.
# Jitter dan packet loss diambil dari profil UDP terpisah di bawah.
QOS_AUTO_IPERF3_PROTOCOL=tcp
# Profil UDP ringan khusus jitter & packet loss, jadwalnya terpisah.
QOS_AUTO_LOSS_ENABLED=true
QOS_AUTO_LOSS_DURATION_SECONDS=2
QOS_AUTO_LOSS_BANDWIDTH=1M
QOS_AUTO_LOSS_INTERVAL_SECONDS=10
# Port terpisah untuk profil UDP (jitter & packet loss) supaya
# sesi UDP yang nyangkut tidak memblokir tes TCP.
QOS_AUTO_LOSS_PORT=5202
# Sumber metrik QoS: vm = probe in-VM (link yang diproses ML), laptop = probe dari laptop.
QOS_SOURCE_MODE=vm
# Probe iperf3/ping dari laptop hanya aktif bila QOS_LOCAL_PROBE=true.
# Saat metrik diambil dari probe in-VM, probe laptop dimatikan agar tidak
# berebut port iperf3 dengan probe in-VM.
QOS_LOCAL_PROBE=false
# Interval probe in-VM (detik) - harus sama dengan qos-probe.timer di VM.
QOS_PROBE_INTERVAL_SECONDS=10

# Runner iperf3 dijalankan manual dari dashboard (tombol "Jalankan tes iperf3").
# Isi IPERF3_SERVER_HOST dengan host server iperf3 yang terjangkau.
IPERF3_ENABLED=false
IPERF3_RESULT_URL=
IPERF3_BINARY=iperf3
IPERF3_CLIENT_HOST=
IPERF3_SERVER_HOST=
IPERF3_PORT=5201
IPERF3_BANDWIDTH=100M
IPERF3_OMIT_SECONDS=0
IPERF3_TEST_PROTOCOL=udp
IPERF3_TEST_DURATION_SECONDS=10
# Batas waktu tambahan sebelum proses iperf3 dihentikan.
IPERF3_TIMEOUT_MARGIN_SECONDS=30
# Tidak dipakai provider live (dokumentasi di README).
IPERF3_TEST_INTERVAL_SECONDS=60

# Delay diukur manual via ICMP ping (tombol "Ukur delay").
# Isi PING_TARGET_HOST dengan target yang mengizinkan ICMP.
DELAY_API_URL=
PING_BINARY=ping
PING_TARGET_HOST=
PING_COUNT=5
PING_TIMEOUT_MS=1000

# Token hanya dibaca backend, tidak pernah dikirim ke browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

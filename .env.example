# Salin menjadi .env lalu sesuaikan. Jangan commit .env berisi secret.
SECRET_KEY=
DATABASE_PATH=instance/dashboard.db
SESSION_LIFETIME_HOURS=8
SESSION_COOKIE_SECURE=false
CSRF_ENABLED=true

# demo = data simulasi berlabel; live = ambil dari sumber eksternal.
DATA_MODE=demo
POLL_INTERVAL_MS=5000
STATS_WINDOW_SECONDS=300
HISTORY_MAX_POINTS=120
API_TIMEOUT_SECONDS=4

API_BASE_URL=http://localhost:5000

# Endpoint sumber data (kosongkan jika belum tersedia).
LIGHTGBM_API_URL=
RANDOM_FOREST_API_URL=
FAIL2BAN_API_URL=
ATTACK_HISTORY_API_URL=
# Token Bearer untuk API attack history (hanya dibaca backend).
ATTACK_HISTORY_API_TOKEN=
# Endpoint 14 fitur flow untuk randomforest-vm (fallback default).
FLOW_FEATURES_API_URL=
# Opsional per VM. Jika kosong, VM terkait menampilkan status belum tersedia.
FLOW_FEATURES_RANDOM_FOREST_URL=
FLOW_FEATURES_LIGHTGBM_URL=
FLOW_FEATURES_FAIL2BAN_URL=
# Opsional; jika kosong memakai ATTACK_HISTORY_API_TOKEN.
FLOW_FEATURES_API_TOKEN=
GLANCES_LIGHTGBM_URL=
GLANCES_RANDOM_FOREST_URL=
GLANCES_FAIL2BAN_URL=
# Contoh integrasi VM RF lewat SSH tunnel lokal:
# GLANCES_RANDOM_FOREST_URL=http://127.0.0.1:61210
# ATTACK_HISTORY_API_URL=http://127.0.0.1:18080/api/attacks
# FLOW_FEATURES_RANDOM_FOREST_URL=http://127.0.0.1:18080/api/features
# Label host yang ditampilkan; ubah untuk host non-VM (mis. laptop-monitoring).
GLANCES_LIGHTGBM_LABEL=lightgbm-vm
GLANCES_RANDOM_FOREST_LABEL=randomforest-vm
GLANCES_FAIL2BAN_LABEL=fail2ban-vm

# QoS (iperf3/ICMP) diukur untuk satu VM. VM lain menampilkan status belum tersedia.
QOS_VM=randomforest-vm
# Retensi titik sampel QoS (independen dari STATS_WINDOW_SECONDS).
QOS_HISTORY_POINTS=240

# Runner iperf3 dijalankan manual dari dashboard (tombol "Jalankan tes iperf3").
# Isi IPERF3_SERVER_HOST dengan host server iperf3 yang terjangkau.
IPERF3_ENABLED=false
IPERF3_RESULT_URL=
IPERF3_BINARY=iperf3
IPERF3_CLIENT_HOST=
IPERF3_SERVER_HOST=
IPERF3_PORT=5201
IPERF3_BANDWIDTH=100M
IPERF3_OMIT_SECONDS=1
IPERF3_TEST_PROTOCOL=udp
IPERF3_TEST_DURATION_SECONDS=10
IPERF3_TEST_INTERVAL_SECONDS=60

# Delay diukur manual via ICMP ping (tombol "Ukur delay").
# Isi PING_TARGET_HOST dengan target yang mengizinkan ICMP.
DELAY_API_URL=
PING_BINARY=ping
PING_TARGET_HOST=
PING_COUNT=5
PING_TIMEOUT_MS=1000

# Token hanya dibaca backend, tidak pernah dikirim ke browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

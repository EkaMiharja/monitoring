# Salin ke /home/server/fail2ban/.fail2ban-api.env lalu isi token.
# Jangan commit file berisi token.
FAIL2BAN_API_TOKEN=
FAIL2BAN_API_BIND=0.0.0.0
FAIL2BAN_API_PORT=8080
FAIL2BAN_API_CLIENT=/usr/bin/fail2ban-client
FAIL2BAN_API_LOG=/var/log/fail2ban.log
FAIL2BAN_API_QOS_DIR=/home/server/fail2ban/qos

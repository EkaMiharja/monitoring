[Unit]
Description=Glances web API (quicklook) untuk dashboard
After=network.target

[Service]
Type=simple
User=server
Group=server
WorkingDirectory=/home/server
Environment=PATH=/home/server/glances-venv/bin:/usr/bin:/bin
ExecStart=/home/server/glances-venv/bin/glances -w --bind 0.0.0.0 -p 61208 --disable-webui
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=Fail2Ban read-only API + QoS status
After=network.target fail2ban.service
Requires=fail2ban.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/server/fail2ban
EnvironmentFile=/home/server/fail2ban/.fail2ban-api.env
ExecStart=/usr/bin/python3 /home/server/fail2ban/fail2ban_api.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/server/fail2ban /var/log/fail2ban.log /var/run/fail2ban
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target

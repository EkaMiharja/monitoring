# Salin ke /home/server/ids-backend/.lightgbm-api.env lalu isi token.
# Jangan commit file berisi token.
LIGHTGBM_API_TOKEN=
LIGHTGBM_API_DB_PATH=/home/server/ids-backend/database/ids.db
LIGHTGBM_API_FEATURES_DIR=/home/server/ids-backend/capture/processed
LIGHTGBM_API_MODEL=LightGBM
# Bind 0.0.0.0 supaya dashboard bisa akses langsung lewat Wi-Fi/LAN.
# ufw nonaktif (allow all); jangan buka VM ke internet.
LIGHTGBM_API_BIND=0.0.0.0
LIGHTGBM_API_PORT=8080

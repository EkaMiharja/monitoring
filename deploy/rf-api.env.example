# Salin ke /home/server/ids-backend/.rf-api.env lalu isi token.
# Jangan commit file berisi token.
RF_API_TOKEN=
RF_API_DB_PATH=/home/server/ids-backend/database/ids.db
RF_API_FEATURES_DIR=/home/server/ids-backend/capture/processed
RF_API_MODEL=RandomForestClassifier
RF_API_BIND=127.0.0.1
RF_API_PORT=8080
